+/**
+ * {@link Deque} backed by an internal {@link LowGcLinkedList}. J21 reversed() method clashes between List and
+ * Deque force this design.
+ * <b>This is not thread-safe.</b>
+ *
+ * @author Ramon Servadei
+ * @see LowGcLinkedList
+ */
+public final class LowGcDeque<E> implements Deque<E>
+{
+    private final LowGcLinkedList<E> delegate;
+
+    public LowGcDeque()
+    {
+        this(UtilProperties.Values.LOW_GC_LINKEDLIST_INTERNAL_SPARE_POOL_SIZE);
+    }
+
+    public LowGcDeque(int maxInternalSparePoolSize)
+    {
+        delegate = new LowGcLinkedList<>(maxInternalSparePoolSize);
+    }
+
+    public void addFirst(E e)
+    {
+        delegate.addFirst(e);
+    }
+
+    public E pollLast()
+    {
+        return delegate.pollLast();
+    }
+
+    public E element()
+    {
+        return delegate.element();
+    }
+
+    public E peek()
+    {
+        return delegate.peek();
+    }
+
+    public E removeLast()
+    {
+        return delegate.removeLast();
+    }
+
+    public E remove()
+    {
+        return delegate.remove();
+    }
+
+    public void clear()
+    {
+        delegate.clear();
+    }
+
+    public E poll()
+    {
+        return delegate.poll();
+    }
+
+    public E pollFirst()
+    {
+        return delegate.pollFirst();
