leExecutor}\r\n         * used by all DataFission {@link Context} instances in the runtime.\r\n         * <br>\r\n         * E.g. <code>-DdataFission.coreThreadCount=8</code>\r\n         */\r\n        String CORE_THREAD_COUNT = BASE + \"coreThreadCount\";\r\n\r\n        /**\r\n         * The system property name to define the number of threads used in the {@link ThimbleExecutor} for\r\n         * RPCs used by all DataFission {@link Context} instances in the runtime.<br> E.g.\r\n         * <code>-DdataFission.rpcThreadCount=4</code>\r\n         */\r\n        String RPC_THREAD_COUNT = BASE + \"rpcThreadCount\";\r\n\r\n        /**\r\n         * The system property name to define the timeout in milliseconds to wait for the execution start of\r\n         * an RPC.<br> E.g. <code>-DdataFission.rpcExecutionStartTimeoutMillis=5000</code>\r\n         */\r\n        String RPC_EXECUTION_START_TIMEOUT_MILLIS = BASE + \"rpcExecutionStartTimeoutMillis\";\r\n\r\n        /**\r\n         * The system property name to define the timeout in milliseconds to wait for the execution duration\r\n         * of an RPC. The duration timeout begins <b>after</b> the RPC execution starts.\r\n         * <br>\r\n         * E.g. <code>-DdataFission.rpcExecutionDurationTimeoutMillis=5000</code>\r\n         */\r\n        String RPC_EXECUTION_DURATION_TIMEOUT_MILLIS = BASE + \"rpcExecutionDurationTimeoutMillis\";\r\n\r\n        /**\r\n         * The system property name to define the period in milliseconds to wait before a {@link ProxyContext}\r\n         * will attempt re-connecting to a {@link Context} after losing the connection.<br> E.g.\r\n         * <code>-DdataFission.proxyReconnectPeriodMillis=1000</code>\r\n         */\r\n        String PROXY_CONTEXT_RECONNECT_PERIOD_MILLIS = BASE + \"proxyReconnectPeriodMillis\";\r\n\r\n        /**\r\n         * The system property name to define the maximum number of atomic changes per message sent from a\r\n         * {@link Publisher}.<br> E.g. <code>-DdataFission.maxChangesPerMessage=20</code>\r\n         */\r\n        String PUBLISHER_MAXIMUM_CHANGES_PER_MESSAGE = BASE + \"maxChangesPerMessage\";\r\n\r\n        /**\r\n         * The system property name to define the period, in seconds, for logging the context core executors\r\n         * statistics.\r\n         * <p>\r\n         * <b>This setting also defines how often the QStats file is updated with the queue\r\n         * statistics.</b>\r\n         * <p>\r\n         * E.g. <code>-DdataFission.statsLoggingPeriodSecs=30</code>\r\n         */\r\n        String STATS_LOGGING_PERIOD_SECS = BASE + \"statsLoggingPeriodSecs\";\r\n\r\n        /**\r\n         * The system property name to define the maximum number of fields in a map to print.<br> E.g.\r\n         * <code>-DdataFission.maxMapFieldsToPrint=30</code>\r\n         */\r\n        String MAX_MAP_FIELDS_TO_PRINT = BASE + \"maxMapFieldsToPrint\";\r\n\r\n        /**\r\n         * The system property name to define the threshold, in nanos, for defining a slow task (and thus\r\n         * logging a message indicating the task was slow).<br> E.g.\r\n         * <code>-DdataFission.slowTaskThresholdNanos=50000000</code>\r\n         */\r\n        String SLOW_TASK_THRESHOLD_NANOS = BASE + \"slowTaskThresholdNanos\";\r\n\r\n        /**\r\n         * The system property name to define the number of threads assigned to the runtime-wide reconnect\r\n         * task scheduler used by all {@link ProxyContext} instances.<br> E.g.\r\n         * <code>-DdataFission.reconnectThreadCount=2</code>\r\n         */\r\n        String RECONNECT_THREAD_COUNT = BASE + \"reconnectThreadCount\";\r\n\r\n        /**\r\n         * The system property name to define the size of the {@link LongValue} pool. E.g.\r\n         * <code>-DdataFission.longValuePoolSize=2048</code>\r\n         */\r\n        String LONG_VALUE_POOL_SIZE = BASE + \"longValuePoolSize\";\r\n\r\n        /**\r\n         * The system property name to define the size of the {@link TextValue} pool.<br> E.g.\r\n         * <code>-DdataFission.textValuePoolSize=2048</code>\r\n         */\r\n        String TEXT_VALUE_POOL_SIZE = BASE + \"textValuePoolSize\";\r\n\r\n        /**\r\n         * The system property name to define the length limit to be eligible for the value to be held in the\r\n         * {@link TextValue} pool.<br> E.g. <code>-DdataFission.textLengthLimitForTextValuePool=5</code>\r\n         */\r\n        String STRING_LENGTH_LIMIT_FOR_TEXT_VALUE_POOL = BASE + \"textLengthLimitForTextValuePool\";\r\n\r\n        /**\r\n         * The system property name to define the estimated maximum number of concurrent threads that will\r\n         * access {@link IRecord} objects in the runtime. This is used to specify the concurrency of the\r\n         * {@link ConcurrentHashMap} components backing the records.<br> E.g.\r\n         * <code>-DdataFission.maxRecordConcurrency=2</code>\r\n         */\r\n        String MAX_RECORD_CONCURRENCY = BASE + \"maxRecordConcurrency\";\r\n\r\n        /**\r\n         * The coalescing window (in milliseconds) for system record publishing. This helps to control the\r\n         * number of messages that a publisher will transmit that are changes to system records, which are\r\n         * generally not processed at the same rate as application records.<br> E.g.\r\n         * <code>-DdataFission.systemRecordCoalesceWindowMillis=250</code>\r\n         */\r\n        String SYSTEM_RECORD_COALESCE_WINDOW_MILLIS = BASE + \"systemRecordCoalesceWindowMillis\";\r\n\r\n        /**\r\n         * The number of deltas pending processing for a record before starting to log them. This helps to\r\n         * reduce chatty logs when network problems interrupt delta sequences. <br> E.g.\r\n         * <code>-DdataFission.deltaCountLogThreshold=6</code>\r\n         */\r\n        String DELTA_COUNT_LOG_THRESHOLD = BASE + \"deltaCountLogThreshold\";\r\n\r\n        /**\r\n         * The number of microseconds to delay the processing of each subscribe message. This reduces image\r\n         * flooding when a {@link ProxyContext} reconnects to a bounced {@link Context}. <br> E.g.\r\n         * <code>-DdataFission.subscribeDelayMicros=100</code>\r\n         */\r\n        String SUBSCRIBE_DELAY_MICROS = BASE + \"subscribeDelayMicros\";\r\n\r\n        /**\r\n         * The batch size to break a mass subscribe into smaller parts for processing. This helps to reduce\r\n         * image flooding when a {@link ProxyContext} reconnects to a bounced {@link Context}. <br> E.g.\r\n         * <code>-DdataFission.subscribeBatchSize=50</code>\r\n         */\r\n        String SUBSCRIBE_BATCH_SIZE = BASE + \"subscribeBatchSize\";\r\n\r\n        /**\r\n         * The maximum pending event queue size before a thread will wait in\r\n         * {@link IPublisherContext#publishAtomicChange(IRecord)} until the queue size goes below this value.\r\n         * Only affects application threads. <br> E.g.\r\n         * <code>-DdataFission.pendingEventThrottleThreshold=200</code>\r\n         */\r\n        String PENDING_EVENT_THROTTLE_THRESHOLD = BASE + \"pendingEventThrottleThreshold\";\r\n\r\n        /**\r\n         * The name of the system property to define the period, in milliseconds, for a {@link Publisher} to\r\n         * publish updates to the {@link ISystemRecordNames#CONTEXT_CONNECTIONS} record. <br> E.g.\r\n         * <code>-DdataFission.connectionsRecordPublishPeriodMillis=30000</code>\r\n         */\r\n        String CONNECTIONS_RECORD_PUBLISH_PERIOD_MILLIS = BASE + \"connectionsRecordPublishPeriodMillis\";\r\n\r\n        /**\r\n         * The maximum size for the rx frame handling tasks pool in a {@link ProxyContext}.<br> E.g.\r\n         * <code>-DdataFission.proxyRxFrameHandlerPoolMaxSize=1000</code>\r\n         */\r\n        String PROXY_RX_FRAME_HANDLER_POOL_MAX_SIZE = BASE + \"proxyRxFrameHandlerPoolMaxSize\";\r\n\r\n        /**\r\n         * Whether thread deadlock checking and thread dumps are enabled. <b>ENABLING THIS IS AN EXPENSIVE\r\n         * OPERATION.</b> <br> E.g. <code>-DdataFission.enableThreadDeadlockCheck=false</code>\r\n         */\r\n        String ENABLE_THREAD_DEADLOCK_CHECK = BASE + \"enableThreadDeadlockCheck\";\r\n\r\n        /**\r\n         * The name of the system property to define the period, in milliseconds, for thread deadlock checks\r\n         * and thread dumps. Only relevant if {@link #ENABLE_THREAD_DEADLOCK_CHECK} is true.<br> E.g.\r\n         * <code>-DdataFission.threadDeadlockCheckPeriodMillis=300000</code>\r\n         *\r\n         * @see Values#ENABLE_THREAD_DEADLOCK_CHECK\r\n         */\r\n        String THREAD_DEADLOCK_CHECK_PERIOD_MILLIS = BASE + \"threadDeadlockCheckPeriodMillis\";\r\n\r\n        /**\r\n         * The name of the system property to define if queue statistics logging is enabled. <br> E.g.\r\n         * <code>-DdataFission.enableQStatsLogging=false</code>\r\n         */\r\n        String ENABLE_Q_STATS_LOGGING = BASE + \"enableQStatsLogging\";\r\n\r\n        /**\r\n         * The name of the system property to define the symmetric transformation. <br> E.g.\r\n         * <code>-DdataFission.encryptedSessionTransformation=AES/ECB/PKCS5Padding</code>\r\n         */\r\n        String ENCRYPTED_SESSION_TRANSFORMATION = BASE + \"encryptedSessionTransformation\";\r\n\r\n        /**\r\n         * The name of the system property to define the rpc names (comma separated) to exclude from logging.\r\n         * <br> E.g. <code>-DdataFission.excludeRpcLogging=runtimeDynamic,runtimeStatic</code>\r\n         */\r\n        String EXCLUDE_RPC_LOGGING = BASE + \"excludeRpcLogging\";\r\n\r\n        /**\r\n         * The name of the system property to define using the classic double value codec.\r\n         * <br> E.g. <code>-DdataFission.useClassicDoubleValueCodec=true</code>\r\n         */\r\n        String USE_CLASSIC_DOUBLE_VALUE_CODEC = BASE + \"useClassicDoubleValueCodec\";\r\n    }\r\n\r\n    /**\r\n     * The values of the properties described in {@link Names}\r\n     *\r\n     * @author Ramon Servadei\r\n     */\r\n    public interface Values\r\n    {\r\n        /**\r\n         * The number of threads used in the system record {@link ThimbleExecutor} used by all DataFission\r\n         * {@link Context} instances in the runtime.\r\n         *\r\n         * @see Names#SYSTEM_THREAD_COUNT\r\n         */\r\n        int SYSTEM_THREAD_COUNT = SystemUtils.getPropertyAsInt(Names.SYSTEM_THREAD_COUNT, 2);\r\n\r\n        /**\r\n         * The number of threads used in the core {@link ThimbleExecutor} used by all DataFission\r\n         * {@link Context} instances in the runtime.\r\n         * <p>\r\n         * These are the defaults for the following processor counts:\r\n         * <ul>\r\n         * <li>small (less than 8 processors) = 4\r\n         * <li>medium (8 to 32 processors) = processors / 2\r\n         * <li>large (over 32 processors) = 16\r\n         * </ul>\r\n         *\r\n         * @see Names#CORE_THREAD_COUNT\r\n         */\r\n        int CORE_THREAD_COUNT = SystemUtils.getPropertyAsInt(Names.CORE_THREAD_COUNT,\r\n                SystemUtils.getRuntimeSupportedThreadCount());\r\n\r\n        /**\r\n         * The number of threads used in the {@link ThimbleExecutor} for RPCs used by all DataFission\r\n         * {@link Context} instances in the runtime.\r\n         * <p>\r\n         * These are the defaults for the following processor counts:\r\n         * <ul>\r\n         * <li>small (less than 8 processors) = 4\r\n         * <li>medium (8 to 32 processors) = processors / 2\r\n         * <li>large (over 32 processors) = 16\r\n         * </ul>\r\n         *\r\n         * @see Names#RPC_THREAD_COUNT\r\n         */\r\n        int RPC_THREAD_COUNT = SystemUtils.getPropertyAsInt(Names.RPC_THREAD_COUNT,\r\n                SystemUtils.getRuntimeSupportedThreadCount());\r\n\r\n        /**\r\n         * The timeout to wait for an RPC to start.\r\n         * <p>\r\n         * Default is: 5000\r\n         *\r\n         * @see Names#RPC_EXECUTION_START_TIMEOUT_MILLIS\r\n         */\r\n        Long RPC_EXECUTION_START_TIMEOUT_MILLIS =\r\n                SystemUtils.getPropertyAsLong(Names.RPC_EXECUTION_START_TIMEOUT_MILLIS, 5000);\r\n\r\n        /**\r\n         * The duration to wait for an RPC to complete after it has started.\r\n         * <p>\r\n         * Default is: 5000\r\n         *\r\n         * @see Names#RPC_EXECUTION_DURATION_TIMEOUT_MILLIS\r\n         */\r\n        Long RPC_EXECUTION_DURATION_TIMEOUT_MILLIS =\r\n                SystemUtils.getPropertyAsLong(Names.RPC_EXECUTION_DURATION_TIMEOUT_MILLIS, 5000);\r\n\r\n        /**\r\n         * The default period in milliseconds that a {@link ProxyContext} waits before reconnecting to a\r\n         * {@link Context} after losing the connection.\r\n         * <p>\r\n         * Default is: 1000\r\n         *\r\n         * @see Names#PROXY_CONTEXT_RECONNECT_PERIOD_MILLIS\r\n         */\r\n        int PROXY_CONTEXT_RECONNECT_PERIOD_MILLIS =\r\n                SystemUtils.getPropertyAsInt(Names.PROXY_CONTEXT_RECONNECT_PERIOD_MILLIS, 1000);\r\n\r\n        /**\r\n         * The default maximum number of changes per message a {@link Publisher} can send.\r\n         * <p>\r\n         * Default is: 20\r\n         *\r\n         * @see Names#PUBLISHER_MAXIMUM_CHANGES_PER_MESSAGE\r\n         */\r\n        int PUBLISHER_MAXIMUM_CHANGES_PER_MESSAGE =\r\n                SystemUtils.getPropertyAsInt(Names.PUBLISHER_MAXIMUM_CHANGES_PER_MESSAGE, 20);\r\n\r\n        /**\r\n         * The period, in seconds, for context core executors statistics logging.\r\n         * <p>\r\n         * Default is: 30\r\n         *\r\n         * @see Names#STATS_LOGGING_PERIOD_SECS\r\n         */\r\n        int STATS_LOGGING_PERIOD_SECS = SystemUtils.getPropertyAsInt(Names.STATS_LOGGING_PERIOD_SECS, 30);\r\n        /**\r\n         * The maximum number of map fields to print.\r\n         * <p>\r\n         * Default is: 30\r\n         *\r\n         * @see Names#MAX_MAP_FIELDS_TO_PRINT\r\n         */\r\n        int MAX_MAP_FIELDS_TO_PRINT = SystemUtils.getPropertyAsInt(Names.MAX_MAP_FIELDS_TO_PRINT, 30);\r\n        /**\r\n         * The threshold value for logging when a task is slow, in nanos\r\n         * <p>\r\n         * Default is: 50000000 (50ms)\r\n         *\r\n         * @see Names#SLOW_TASK_THRESHOLD_NANOS\r\n         */\r\n        long SLOW_TASK_THRESHOLD_NANOS =\r\n                SystemUtils.getPropertyAsLong(Names.SLOW_TASK_THRESHOLD_NANOS, 50_000_000);\r\n\r\n        /**\r\n         * The number of threads used in the shared reconnect task scheduler used by all DataFission\r\n         * {@link ProxyContext} instances in the runtime.\r\n         * <p>\r\n         * Default is 2.\r\n         *\r\n         * @see Names#RECONNECT_THREAD_COUNT\r\n         */\r\n        int RECONNECT_THREAD_COUNT = Integer.parseInt(System.getProperty(Names.RECONNECT_THREAD_COUNT, \"1\"));\r\n\r\n        /**\r\n         * The size for the {@link LongValue} pool.\r\n         * <p>\r\n         * Default is 2048.\r\n         *\r\n         * @see Names#LONG_VALUE_POOL_SIZE\r\n         */\r\n        int LONG_VALUE_POOL_SIZE = SystemUtils.getPropertyAsInt(Names.LONG_VALUE_POOL_SIZE, 2048);\r\n\r\n        /**\r\n         * The size for the {@link TextValue} pool.\r\n         * <p>\r\n         * Default is 0 (unlimited).\r\n         *\r\n         * @see Names#TEXT_VALUE_POOL_SIZE\r\n         */\r\n        int TEXT_VALUE_POOL_SIZE = SystemUtils.getPropertyAsInt(Names.TEXT_VALUE_POOL_SIZE, 0);\r\n\r\n        /**\r\n         * The text length limit to be eligible for the value to be held in the {@link TextValue} pool.\r\n         * <p>\r\n         * Default is 5.\r\n         *\r\n         * @see Names#STRING_LENGTH_LIMIT_FOR_TEXT_VALUE_POOL\r\n         */\r\n        int STRING_LENGTH_LIMIT_FOR_TEXT_VALUE_POOL =\r\n                SystemUtils.getPropertyAsInt(Names.STRING_LENGTH_LIMIT_FOR_TEXT_VALUE_POOL, 5);\r\n\